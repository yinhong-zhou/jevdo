# Keep secrets only in .env. No credentials from other projects are copied.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Experiment CLI resolves relative paths against this repository.
# When exporting this setting to native DSH, use an absolute path for cross-project sharing.
JEV_ACTION_HOME=.jevaction
# Optional fixed model ID from config/models.json; blank enables Jev routing.
JEV_FIXED_MODEL=
